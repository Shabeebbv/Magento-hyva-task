<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="shabeeb_guest_wishlist_item" resource="default" engine="innodb" comment="Guest wishlist items keyed by an anonymous cookie token">
        <column xsi:type="int" name="item_id" unsigned="true" nullable="false" identity="true" comment="Item ID"/>
        <column xsi:type="varchar" name="guest_token" length="64" nullable="false" comment="Anonymous guest token"/>
        <column xsi:type="int" name="product_id" unsigned="true" nullable="false" comment="Product ID"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false" default="0" comment="Store ID"/>
        <column xsi:type="decimal" name="qty" scale="4" precision="12" unsigned="false" nullable="false" default="1" comment="Qty"/>
        <column xsi:type="timestamp" name="added_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Added At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="item_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="SHABEEB_GUEST_WISHLIST_ITEM_TOKEN_PRODUCT_STORE">
            <column name="guest_token"/>
            <column name="product_id"/>
            <column name="store_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="SHABEEB_GUEST_WISHLIST_ITEM_PRODUCT_ID_CAT_PRD_ENTT_ENTT_ID"
                    table="shabeeb_guest_wishlist_item" column="product_id"
                    referenceTable="catalog_product_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="SHABEEB_GUEST_WISHLIST_ITEM_STORE_ID_STORE_STORE_ID"
                    table="shabeeb_guest_wishlist_item" column="store_id"
                    referenceTable="store" referenceColumn="store_id" onDelete="CASCADE"/>
        <index referenceId="SHABEEB_GUEST_WISHLIST_ITEM_GUEST_TOKEN" indexType="btree">
            <column name="guest_token"/>
        </index>
    </table>
</schema>
