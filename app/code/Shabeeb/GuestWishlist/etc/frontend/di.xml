<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Route every "Add to Wish List" button through our controller, which serves guests and customers. -->
    <type name="Magento\Wishlist\Helper\Data">
        <plugin name="shabeeb_guest_wishlist_add_params" type="Shabeeb\GuestWishlist\Plugin\WishlistHelperPlugin"/>
    </type>
    <type name="Magento\Customer\CustomerData\SectionPoolInterface">
        <arguments>
            <argument name="sectionSourceMap" xsi:type="array">
                <item name="shabeeb-wishlist" xsi:type="string">Shabeeb\GuestWishlist\CustomerData\Wishlist</item>
            </argument>
        </arguments>
    </type>
</config>
