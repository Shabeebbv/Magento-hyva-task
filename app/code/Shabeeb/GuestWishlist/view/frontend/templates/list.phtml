<?php
/** @var \Shabeeb\GuestWishlist\Block\GuestList $block */
/** @var \Magento\Framework\Escaper $escaper */
$products = $block->getProducts();
?>
<div class="shabeeb-guest-wishlist">
    <?php if (!$products): ?>
        <div class="message info empty"><span><?= $escaper->escapeHtml(__('You have no items in your wish list.')) ?></span></div>
    <?php else: ?>
        <p class="shabeeb-guest-wishlist-note">
            <?= $escaper->escapeHtml(__('Your wish list is saved on this device. Sign in to keep it in your account.')) ?>
        </p>
        <ol class="products list items product-items shabeeb-guest-wishlist-items">
            <?php foreach ($products as $product): ?>
                <li class="item product product-item" data-product-id="<?= (int)$product->getId() ?>">
                    <div class="product-item-info">
                        <a class="product photo product-item-photo" href="<?= $escaper->escapeUrl($product->getProductUrl()) ?>" tabindex="-1">
                            <img class="product-image-photo" src="<?= $escaper->escapeUrl($block->getImageUrl($product)) ?>"
                                 alt="<?= $escaper->escapeHtmlAttr($product->getName()) ?>" loading="lazy" width="240" height="300"/>
                        </a>
                        <div class="product details product-item-details">
                            <strong class="product name product-item-name">
                                <a class="product-item-link" href="<?= $escaper->escapeUrl($product->getProductUrl()) ?>">
                                    <?= $escaper->escapeHtml($product->getName()) ?>
                                </a>
                            </strong>
                            <?= /* @noEscape */ $block->getPriceHtml($product) ?>
                            <div class="product actions product-item-actions">
                                <?php if ($product->isSaleable()): ?>
                                    <form action="<?= $escaper->escapeUrl($block->getAddToCartUrl($product)) ?>" method="post">
                                        <?= $block->getBlockHtml('formkey') ?>
                                        <input type="hidden" name="product" value="<?= (int)$product->getId() ?>"/>
                                        <button type="submit" class="action tocart primary">
                                            <span><?= $escaper->escapeHtml(__('Add to Cart')) ?></span>
                                        </button>
                                    </form>
                                <?php endif; ?>
                                <form action="<?= $escaper->escapeUrl($block->getRemoveUrl()) ?>" method="post">
                                    <?= $block->getBlockHtml('formkey') ?>
                                    <input type="hidden" name="product" value="<?= (int)$product->getId() ?>"/>
                                    <button type="submit" class="action delete">
                                        <span><?= $escaper->escapeHtml(__('Remove')) ?></span>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </li>
            <?php endforeach; ?>
        </ol>
    <?php endif; ?>
</div>
