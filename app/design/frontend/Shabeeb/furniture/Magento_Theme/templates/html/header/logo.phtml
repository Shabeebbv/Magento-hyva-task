<?php
/**
 * Text logo. Keeps the nav toggle from the core Magento_Theme::html/header/logo.phtml.
 *
 * @var \Magento\Theme\Block\Html\Header\Logo $block
 * @var \Magento\Framework\Escaper $escaper
 */
$storeName = $block->getLogoAlt();
?>
<span data-action="toggle-nav" class="action nav-toggle"><span><?= $escaper->escapeHtml(__('Toggle Nav')) ?></span></span>
<a class="logo shabeeb-logo"
   href="<?= $escaper->escapeUrl($block->getUrl('')) ?>"
   title="<?= $escaper->escapeHtmlAttr($storeName) ?>"
   aria-label="<?= $escaper->escapeHtmlAttr(__('%1 home', $storeName)) ?>">
    <span class="shabeeb-logo-name"><?= $escaper->escapeHtml(__('2XL')) ?></span>
    <span class="shabeeb-logo-tag"><?= $escaper->escapeHtml(__('Home')) ?></span>
</a>
