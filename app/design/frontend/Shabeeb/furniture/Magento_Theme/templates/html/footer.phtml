<?php
/**
 * Footer link columns plus the newsletter form, moved in as the "subscribe" child.
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\Escaper $escaper
 */
$columns = [
    [__('Shop'), [
        [__('Furniture'), $block->getUrl('', ['_direct' => 'furniture.html'])],
        [__('Serene Hydraulic Bed'), $block->getUrl('', ['_direct' => 'serene-bed.html'])],
    ]],
    [__('My Account'), [
        [__('Sign In'), $block->getUrl('customer/account/login')],
        [__('Create an Account'), $block->getUrl('customer/account/create')],
        [__('Wish List'), $block->getUrl('guestwishlist')],
        [__('Shopping Cart'), $block->getUrl('checkout/cart')],
    ]],
    [__('Customer Service'), [
        [__('Contact Us'), $block->getUrl('contact')],
        [__('Orders and Returns'), $block->getUrl('sales/guest/form')],
    ]],
    [__('Policies'), [
        [__('Privacy and Cookie Policy'), $block->getUrl('', ['_direct' => 'privacy-policy-cookie-restriction-mode'])],
    ]],
];
?>
<div class="shabeeb-footer">
    <?php foreach ($columns as [$title, $links]): ?>
        <nav class="shabeeb-footer-column" aria-label="<?= $escaper->escapeHtmlAttr($title) ?>">
            <h2 class="shabeeb-footer-title"><?= $escaper->escapeHtml($title) ?></h2>
            <ul>
                <?php foreach ($links as [$label, $url]): ?>
                    <li><a href="<?= $escaper->escapeUrl($url) ?>"><?= $escaper->escapeHtml($label) ?></a></li>
                <?php endforeach; ?>
            </ul>
        </nav>
    <?php endforeach; ?>
    <?php if ($subscribe = $block->getChildHtml('subscribe')): ?>
        <div class="shabeeb-footer-newsletter">
            <h2 class="shabeeb-footer-title"><?= $escaper->escapeHtml(__('Sign Up for Newsletter')) ?></h2>
            <?= /* @noEscape */ $subscribe ?>
        </div>
    <?php endif; ?>
</div>
