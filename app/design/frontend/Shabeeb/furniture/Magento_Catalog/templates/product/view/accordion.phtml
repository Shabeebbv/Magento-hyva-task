<?php
/**
 * Description and shipping notes as collapsible sections in the purchase column.
 *
 * @var \Magento\Catalog\Block\Product\View $block
 * @var \Magento\Framework\Escaper $escaper
 */
$product = $block->getProduct();
/** @var \Magento\Catalog\Helper\Output $outputHelper */
$outputHelper = $this->helper(\Magento\Catalog\Helper\Output::class);
$description = (string)$product->getDescription();
?>
<div class="shabeeb-accordion">
    <?php if ($description !== ''): ?>
        <details class="shabeeb-accordion-item" open>
            <summary><?= $escaper->escapeHtml(__('Product Description')) ?></summary>
            <div class="shabeeb-accordion-content">
                <?= /* @noEscape */ $outputHelper->productAttribute($product, $description, 'description') ?>
            </div>
        </details>
    <?php endif; ?>
    <details class="shabeeb-accordion-item">
        <summary><?= $escaper->escapeHtml(__('Shipping and Returns')) ?></summary>
        <div class="shabeeb-accordion-content">
            <p><?= $escaper->escapeHtml(__('Free delivery across the UAE on orders over AED 1,000. Usually 3–7 working days.')) ?></p>
            <p><?= $escaper->escapeHtml(__('Changed your mind? Return unused items within 14 days.')) ?></p>
        </div>
    </details>
</div>
