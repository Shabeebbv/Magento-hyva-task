<?php
/**
 * Pay-in-instalments teaser under Add to Cart, opening a modal with example plans (js/installment-modal).
 * Illustrative only: the store has no instalment payment integration, so the copy never offers a real plan.
 * Provider name and payment counts come from layout arguments in catalog_product_view.xml.
 *
 * @var \Magento\Catalog\Block\Product\View $block
 * @var \Magento\Framework\Escaper $escaper
 */
/** @var \Shabeeb\Storefront\ViewModel\InstallmentExamples $installments */
$installments = $block->getData('installments');
$price = $installments->getPrice($block->getProduct());
$plans = $installments->getPlans($price, (string)$block->getData('payment_counts'));
if (!$plans) {
    return;
}
$provider = (string)$block->getData('provider_name');
$longest = end($plans);
$id = 'shabeeb-installments-' . (int)$block->getProduct()->getId();
?>
<div class="shabeeb-installments" data-mage-init='{"js/installment-modal": {}}'>
    <button type="button" class="shabeeb-installments-trigger" data-role="installments-open"
            aria-haspopup="dialog" aria-controls="<?= $escaper->escapeHtmlAttr($id) ?>">
        <span class="shabeeb-installments-teaser">
            <?= $escaper->escapeHtml(__('From')) ?>
            <strong><?= $escaper->escapeHtml($installments->format($longest['payment'])) ?></strong><?= $escaper->escapeHtml(__('/month for up to %1 payments.', $longest['count'])) ?>
            <span class="shabeeb-installments-more"><?= $escaper->escapeHtml(__('Example plans')) ?></span>
        </span>
        <?php if ($provider !== ''): ?>
            <span class="shabeeb-bnpl-badge" aria-hidden="true"><?= $escaper->escapeHtml($provider) ?></span>
        <?php endif; ?>
    </button>

    <dialog class="shabeeb-installments-modal" id="<?= $escaper->escapeHtmlAttr($id) ?>"
            aria-labelledby="<?= $escaper->escapeHtmlAttr($id) ?>-title" data-role="installments-modal">
        <button type="button" class="shabeeb-installments-close" data-role="installments-close"
                aria-label="<?= $escaper->escapeHtmlAttr(__('Close')) ?>"></button>
        <div class="shabeeb-installments-body">
            <?php if ($provider !== ''): ?>
                <span class="shabeeb-bnpl-badge"><?= $escaper->escapeHtml($provider) ?></span>
            <?php endif; ?>
            <h2 class="shabeeb-installments-title" id="<?= $escaper->escapeHtmlAttr($id) ?>-title">
                <?= $escaper->escapeHtml(__('Your payment, your pace')) ?>
            </h2>
            <p class="shabeeb-installments-lead">
                <?= $escaper->escapeHtml(__('Pay as low as')) ?>
                <strong><?= $escaper->escapeHtml($installments->format($longest['payment'])) ?>/<?= $escaper->escapeHtml(__('mo')) ?></strong>,
                <?= $escaper->escapeHtml(__('or in %1 payments', $longest['count'])) ?>
            </p>
            <p class="shabeeb-installments-notice">
                <?= $escaper->escapeHtml(__('Illustrative example only. Instalment payments are not available at checkout in this store yet.')) ?>
            </p>

            <h3 class="shabeeb-installments-subtitle"><?= $escaper->escapeHtml(__('Example plans')) ?></h3>
            <ul class="shabeeb-installments-plans">
                <?php foreach ($plans as $plan): ?>
                    <li class="shabeeb-installments-plan">
                        <span class="shabeeb-installments-amount">
                            <?= $escaper->escapeHtml($installments->format($plan['payment'])) ?>/<?= $escaper->escapeHtml(__('mo')) ?>
                        </span>
                        <span class="shabeeb-installments-pill"><?= $escaper->escapeHtml(__('%1 Payments', $plan['count'])) ?></span>
                        <span class="shabeeb-installments-fee">
                            <?= $escaper->escapeHtml(__('Before any fees. Fees may apply.')) ?>
                            <?php if ($plan['last'] !== $plan['payment']): ?>
                                <?= $escaper->escapeHtml(__('Last payment %1.', $installments->format($plan['last']))) ?>
                            <?php endif; ?>
                        </span>
                    </li>
                <?php endforeach; ?>
                <li class="shabeeb-installments-plan">
                    <span class="shabeeb-installments-amount"><?= $escaper->escapeHtml($installments->format($price)) ?></span>
                    <span class="shabeeb-installments-pill"><?= $escaper->escapeHtml(__('Pay in Full')) ?></span>
                    <span class="shabeeb-installments-fee"><?= $escaper->escapeHtml(__('One payment at checkout.')) ?></span>
                </li>
            </ul>

            <p class="shabeeb-installments-fineprint">
                <?= $escaper->escapeHtml(__('Amounts are the current product price divided into equal payments, rounded down to the fils; the last payment covers any remainder. They exclude delivery, other cart items and any provider fees or interest. They are not an offer or an approved payment plan: any real plan would depend on the provider, eligibility checks and its terms at checkout.')) ?>
            </p>
        </div>
    </dialog>
</div>
