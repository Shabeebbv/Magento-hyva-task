<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- Title, category and SKU, then price and purchase controls, then description sections -->
        <referenceContainer name="product.info.main">
            <block class="Magento\Catalog\Block\Product\View" name="shabeeb.product.category"
                   template="Magento_Catalog::product/view/category-label.phtml" before="product.info.price"/>
            <block class="Magento\Catalog\Block\Product\View" name="shabeeb.product.accordion"
                   template="Magento_Catalog::product/view/accordion.phtml" after="-"/>
        </referenceContainer>
        <!-- Gallery and purchase panel share one row, so the sticky panel stops where the gallery ends
             (Luma floats them straight inside the main column, next to the tabs below) -->
        <referenceContainer name="content">
            <container name="shabeeb.product.top" htmlTag="div" htmlClass="shabeeb-pdp-top" before="-">
                <block class="Magento\Framework\View\Element\Template" name="shabeeb.product.sticky"
                       template="Magento_Catalog::product/view/sticky-panel.phtml"/>
            </container>
        </referenceContainer>
        <move element="product.info.media" destination="shabeeb.product.top" before="-"/>
        <move element="product.info.main" destination="shabeeb.product.top" after="product.info.media"/>

        <!-- Example instalment plans under Add to Cart (illustrative only, no payment integration).
             provider_name: label on the badge, empty to hide it; payment_counts: comma-separated plan lengths -->
        <referenceContainer name="product.info.main">
            <block class="Magento\Catalog\Block\Product\View" name="shabeeb.product.installments"
                   template="Magento_Catalog::product/view/installments.phtml" after="product.info">
                <arguments>
                    <argument name="installments" xsi:type="object">Shabeeb\Storefront\ViewModel\InstallmentExamples</argument>
                    <argument name="provider_name" xsi:type="string">tamara</argument>
                    <argument name="payment_counts" xsi:type="string">2,3,4,6,9,12</argument>
                </arguments>
            </block>
        </referenceContainer>

        <!-- Under the title: category label, then SKU and reviews, then the price -->
        <move element="product.info.stock.sku" destination="product.info.main" before="product.info.price"/>
        <move element="product.info.review" destination="product.info.main" before="product.info.price"/>

        <!-- The description lives in the accordion; the tabs below keep Reviews -->
        <referenceBlock name="product.info.description" remove="true"/>
        <referenceBlock name="product.info.overview" remove="true"/>
        <referenceBlock name="view.addto.compare" remove="true"/>
        <referenceBlock name="product.info.mailto" remove="true"/>
    </body>
</page>
